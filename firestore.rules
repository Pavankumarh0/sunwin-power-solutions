rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ============================================
    // CONTACT FORM SUBMISSIONS
    // ============================================
    // Allows anyone to submit the contact form
    // Admin dashboard can read and delete submissions
    match /contacts/{contactId} {
      // Anyone can create (submit contact form)
      // Email is optional (can be empty string for popup submissions)
      allow create: if true 
                    && request.resource.data.keys().hasAll(['name', 'email', 'phone', 'message'])
                    && request.resource.data.name is string
                    && request.resource.data.email is string
                    && request.resource.data.phone is string
                    && request.resource.data.message is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.phone.size() > 0
                    && request.resource.data.message.size() > 0
                    && (request.resource.data.email.size() == 0 || request.resource.data.email.matches('.+@.+[.].+'));
      
      // Allow reading for admin dashboard
      allow read: if true;
      
      // Allow delete for admin dashboard
      allow delete: if true;
      
      // Nobody can update submissions
      allow update: if false;
    }
    
    // ============================================
    // DEFAULT RULE - DENY ALL OTHER ACCESS
    // ============================================
    // Deny access to any other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

